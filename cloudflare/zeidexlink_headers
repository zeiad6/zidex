# ZeidexLink — SaaS & Micro-Store Security Headers
# Balanced CSP supporting 12 tracking pixels, media embeds, and CSS exfiltration defense
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)

  # Content-Security-Policy (CSP)
  # Allows:
  # - Google Analytics (GA4) & GTM
  # - Meta / Facebook Pixel
  # - TikTok Pixel
  # - Snapchat Pixel
  # - Twitter / X Pixel
  # - LinkedIn Insight Tag
  # - Pinterest Tag
  # - Microsoft Clarity & Hotjar
  # - Google Maps & YouTube embeds
  # - Embedded PDFs (blob:)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://analytics.tiktok.com https://sc-static.net https://static.ads-twitter.com https://snap.licdn.com https://ct.pinterest.com https://www.clarity.ms https://static.hotjar.com https://script.hotjar.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; media-src 'self' https: blob:; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://*.facebook.com https://analytics.tiktok.com https://tr.snapchat.com https://*.clarity.ms https://*.hotjar.io https://api.moyasar.com https://api.stripe.com; frame-src 'self' https://www.google.com/maps/ https://www.youtube.com/ https://drive.google.com/; object-src 'self' blob:; worker-src 'self' blob:; base-uri 'self'; form-action 'self';

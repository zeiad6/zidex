# dependencies
node_modules/
.pnp
.pnp.js

# build output
dist/
dist-ssr/
build/
.netlify/

# env
.env
.env.local
.env.*.local

# editors
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# typescript
*.tsbuildinfo

# misc
.cache/
.impeccable/
.temp/
.tmp/
coverage/

# Cloudflare local secrets and state
.dev.vars
.dev.vars.*
.wrangler/

# Generated bot payload (sealed token + derived webhook secret) — never commit
payload.json

# WhatsApp account-bot session credentials (Baileys auth state) — never commit
.wa-session/

# API key validation scratch data (contains provider keys) — never commit
keycheck/
*.pckey.txt

# Python caches
__pycache__/
*.pyc

# قوالب المتاجر — لكل قالب مستودعه الخاص (تُنشر مخرجاته إلى public/templates/)
store-sites/

# واجهات البوتات — مستودع فرعي مستقل (تُنشر مخرجاته إلى public/bot-suite/)
bot-suite/
!public/bot-suite/

# قاعدة بيانات CRM المحلية (وليدة تشغيل محلي — لا تُرفع)
CRM/crm.db
CRM/crm.db-wal
CRM/crm.db-shm

{
  "name": "tiktokweb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ghost 778 — TikTok hub, link hub and blog",
  "scripts": {
    "dev": "vite",
    "build": "npm run sync-meta && tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "sync-meta": "node scripts/sync-post-meta.mjs",
    "sync-meta:write": "node scripts/sync-post-meta.mjs --write",
    "deploy:cf": "npm run build && node scripts/cf-headers.mjs && rm -f dist/_redirects && npx -y wrangler@4 deploy",
    "indexnow": "node scripts/indexnow.mjs",
    "test:license": "node scripts/test-license.mjs",
    "test:botlic": "node scripts/test-bot-licensing.mjs",
    "test": "node scripts/test-bots.mjs && node scripts/test-license.mjs && node scripts/test-bot-licensing.mjs && node scripts/test-store-app.mjs",
    "gen:license-keys": "node scripts/gen-license-keys.mjs --env",
    "test:store": "node scripts/test-store-app.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7"
  }
}
